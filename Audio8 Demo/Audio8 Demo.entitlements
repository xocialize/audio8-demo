<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app is sandboxed, so every path outside the container must be reached
	     through a user grant or an app-scope bookmark. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Weight materialization downloads from Hugging Face on first run. Without this
	     the download fails rather than falling back to anything. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Two uses: granting the shared models folder (so weights are not re-downloaded
	     per app), and the open/save panels for custom reference clips and metric exports. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Persists the models-folder grant across launches. Without it the user re-picks
	     the folder every time the app starts. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
